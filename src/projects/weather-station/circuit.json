{
  "board": "ESP32_DEVKIT_V1",
  "peripherals": [
    {
      "id": "oled_screen",
      "type": "SSD1306_OLED",
      "name": "SSD1306 OLED Kijelző (128x64)",
      "pins": {
        "sda": 21,
        "scl": 22
      },
      "config": {
        "i2cAddress": "0x3C",
        "width": 128,
        "height": 64
      }
    },
    {
      "id": "bmp280_sensor",
      "type": "BMP280_BAROMETER",
      "name": "BMP280 Barométer & Hőmérő",
      "pins": {
        "sda": 25,
        "scl": 26
      },
      "config": {
        "i2cAddress": "0x76",
        "defaultTemp": 24.5,
        "defaultPressure": 1013.25
      }
    },
    {
      "id": "rotary_knob",
      "type": "KY040_ROTARY_ENCODER",
      "name": "KY-040 Forgó Jeladó",
      "pins": {
        "clk": 18,
        "dt": 19,
        "sw": 23
      }
    },
    {
      "id": "btn_back",
      "type": "PUSH_BUTTON",
      "name": "Vissza Gomb",
      "pins": {
        "pin": 14
      },
      "config": {
        "pullUp": true
      }
    },
    {
      "id": "status_led",
      "type": "LED",
      "name": "Állapotjelző LED",
      "pins": {
        "pin": 13
      }
    }
  ]
}
